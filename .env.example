# LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LangSmith
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=aegis-production

# Database / Memory
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# Tools
TAVILY_API_KEY=
COHERE_API_KEY=
GITHUB_TOKEN=
SLACK_BOT_TOKEN=

# API
API_PORT=8000

# Public demo: live inference is on when an LLM key is set.
# Set LIVE_MODE=false to force demo/sim even with keys present.
LIVE_MODE=true
ENABLE_DEBUG=false
PUBLIC_RUN_TOKEN=
CORS_ORIGINS=https://aegis-agent-api.vercel.app,http://localhost:8000,http://127.0.0.1:8000
